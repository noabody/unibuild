diff a/python-wstart/PKGBUILD b/python-wstart/PKGBUILD
--- a/python-wstart/PKGBUILD	1969-12-31 17:00:00.000000000 -0700
+++ b/python-wstart/PKGBUILD	1969-12-31 17:00:00.000000000 -0700
@@ -0,0 +1,35 @@
+# Maintainer: Noa Body <noabody@archlinux.org>
+
+pkgname=python-wstart
+pkgver=0.4
+pkgrel=1
+pkgdesc="Wine Starter."
+url=https://github.com/noabody
+arch=(any)
+license=(Unlicense)
+depends=(python python-pefile)
+makedepends=(python-build python-flit python-installer python-wheel)
+provides=("${pkgname#*-}")
+conflicts=("${pkgname#*-}")
+noextract=(master.tar.gz)
+source=(https://github.com/noabody/unibuild/archive/refs/heads/master.tar.gz
+        "$pkgname".patch)
+sha256sums=('SKIP'
+            '4530440d7f92a239be067e3acd986c336d27a5d2c81ddb0d9f5b3674035adeb3')
+
+prepare() {
+  tar -xzf master.tar.gz -C "$srcdir" --strip-components=2 --wildcards "*/data/${pkgname#*-}.py"
+  rm -f "$srcdir"/*.toml
+  patch -Np1 -i "$pkgname".patch
+}
+
+build() {
+  cd "$srcdir"
+  python -m build --wheel --no-isolation
+}
+
+package() {
+  cd "$srcdir"
+  python -m installer --destdir="$pkgdir" dist/*.whl
+  rm -f "$startdir"/master.tar.gz
+}
