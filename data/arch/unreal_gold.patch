diff a/unreal_gold/PKGBUILD b/unreal_gold/PKGBUILD
--- a/unreal_gold/PKGBUILD	1969-12-31 17:00:00.000000000 -0700
+++ b/unreal_gold/PKGBUILD	1969-12-31 17:00:00.000000000 -0700
@@ -0,0 +1,41 @@
+# Maintainer: Noa Body <noabody@archlinux.org>
+
+pkgname=unreal_gold
+_ver=227k #"$(git ls-remote https://github.com/OldUnreal/Unreal-testing | grep -Pio '[^/]+$' | grep -Pio '(?<=^v)2.*\d$' | sort -V | tail -1)"
+_sub=16 #"${_ver#*_}" _ver="${_ver%_*}"
+pkgver="$_ver.r$_sub"
+pkgrel=1
+pkgdesc='Unreal Gold native Linux port powered by OldUnreal.'
+arch=(x86_64)
+url='https://www.oldunreal.com'
+license=('custom:proprietary')
+depends=(glibc hicolor-icon-theme libatomic)
+makedepends=(gendesk icoextract icoutils inkscape imagemagick)
+noextract=(winpatch.zip)
+source=(patch.tar.bz2::https://github.com/OldUnreal/Unreal-testing/releases/download/v"$_ver"_"$_sub"/OldUnreal-UnrealPatch"$_ver"-Linux.tar.bz2
+        winpatch.zip::https://github.com/OldUnreal/Unreal-testing/releases/download/v"$_ver"_"$_sub"/OldUnreal-UnrealPatch"$_ver"-Windows.zip
+        "$pkgname".sh)
+sha256sums=('SKIP'
+            'SKIP'
+            'a1e7649f3b2d66bd5c63f2b54c4e288569d292f4ac9bea8e669b5d01aa430fc3')
+
+prepare() {
+  unzip -ju winpatch.zip "*/Unreal.exe"
+  rm -rf {Sounds,SystemLocalized}/{ctt,det,elt,est,frt,itt,nlt,plt,ptt,rut,SetupIntl,*.ini,.git*} System/*{-x86,.{det,est,frt,int,itt,so*}}
+  gendesk -f -n --name='Unreal Gold' --comment="${pkgdesc/.}" --custom='Keywords=game;engine;' --exec="$pkgname" --icon="$pkgname" --terminal=false --categories='GNOME;GTK;Game' --startupnotify=false --pkgname="$pkgname"
+  if [[ ! -f "$pkgname.svg" ]]; then
+    icoextract -i 128 -n 1 Unreal.exe Unreal.ico
+    icotool -i 2 -x Unreal.ico -o "$pkgname".png
+    magick "$pkgname".png -thumbnail 256x256 -fuzz 10% -transparent black -strip "$pkgname".png
+    inkscape "$pkgname".png --export-plain-svg --export-filename="$pkgname".svg
+    rm -f Unreal.ico "$pkgname".png
+  fi
+}
+
+package() {
+  install -dm 755 "$pkgdir"/usr/{bin,share/{"$pkgname",applications,icons/hicolor/scalable/apps}}
+  cp -dr --no-preserve='ownership' {Help,Maps,Music,Sounds,System,System64,SystemLocalized,Textures,WebServer} "$pkgdir"/usr/share/"$pkgname"/
+  install -m 755 "$pkgname".sh "$pkgdir"/usr/bin/"$pkgname"
+  install -m 644 "$pkgname".desktop "$pkgdir"/usr/share/applications/
+  install -m 644 "$pkgname".svg "$pkgdir"/usr/share/icons/hicolor/scalable/apps/
+}
diff a/unreal_gold/unreal_gold.sh b/unreal_gold/unreal_gold.sh
--- a/unreal_gold/unreal_gold.sh	1969-12-31 17:00:00.000000000 -0700
+++ b/unreal_gold/unreal_gold.sh	1969-12-31 17:00:00.000000000 -0700
@@ -0,0 +1,65 @@
+#!/bin/bash
+gmdir="$HOME/games/unreal_gold"
+gmcfg="$HOME/.Unreal"
+gmtgt="Maps/Unreal.unr"
+gmprm="" # -nohomedir -ini=$gmcfg/System/UnrealLinux.ini -userini=$gmcfg/System/User.ini -log=$gmcfg/System/unreal-bin-amd64.log
+glnch="unreal-bin-amd64"
+
+gconf() {
+mkdir -p "$gmcfg"
+printf 'gamepath=%s\ngamemod=%s\ngameparm=%s\n' "$gmdir" "$gmtgt" "$gmprm" > "$gmcfg/basedir"
+}
+
+gstart () {
+mkdir -p "$gmcfg"/System "$gmbdr"/{Cache,Compress,Save}
+[[ -f "$gmcfg/System/UnrealLinux.ini" ]] || cp /usr/share/unreal_gold/System64/DefaultLinux.ini "$gmcfg/System/UnrealLinux.ini"
+[[ -f "$gmcfg/System/User.ini" ]] || cp /usr/share/unreal_gold/System64/DefUser.ini "$gmcfg/System/User.ini"
+grep -Pioq '(=|=\")\.\./' "$gmcfg/System/UnrealLinux.ini" && perl -pi -e "s#(?<==|=\")\.\.(?=/(Cache|Compress|Maps|Meshes|Music|Save|Sounds|System|System64|SystemLocalized|Textures))#$gmbdr#gi" "$gmcfg/System/UnrealLinux.ini"
+while IFS= read -r -d '' file; do
+  [[ -d "$gmbdr/$file" ]] || mkdir -p "$gmbdr/$file"
+done < <(find /usr/share/unreal_gold -mindepth 1 -type d -printf '%P\0')
+while IFS= read -r -d '' file; do
+  [[ -h "$gmbdr/$file" ]] || ln -sf "/usr/share/unreal_gold/$file" "$gmbdr/$file"
+done < <(find /usr/share/unreal_gold -mindepth 2 -type f -printf '%P\0')
+echo "cd $gmbdr/System64 && ./$glnch $gmpar" | xargs -i -r sh -c "{}"
+}
+
+gtest () {
+gmbse="" gmbdr="" gmgme="" gmgnm="" gmgpm="" gmpar=""
+
+if [[ -f "$gmcfg/basedir" ]]; then
+  while IFS='=' read -r key val || [ -n "$key" ]; do
+    case "$key" in
+      gamepath) gmbse="gamepath=$val"; gmbdr="$val" ;;
+      gamemod)  gmgme="gamemod=$val";  gmgnm="$val" ;;
+      gameparm) gmgpm="gameparm=$val"; gmpar="$val" ;;
+    esac
+  done < "$gmcfg/basedir"
+fi
+}
+
+[[ -f "$gmcfg/basedir" ]] || gconf
+gtest
+if [[ -z "$gmbdr" ]]; then
+  gconf
+  gtest
+fi
+if [[ -d "$gmbdr" ]]; then
+  if [[ ! -f "$gmbdr/$gmgnm" ]]; then
+    gmchk="$(find -H "$gmbdr" -mindepth 1 -maxdepth 2 -type f -regextype posix-extended -iregex "$gmbdr/$gmgnm" -printf '%p\n' | grep -Pic "$gmbdr/$gmgnm")"
+    if (( $gmchk == 1 )) ; then
+      echo -e "File system is case sensitive\nFile/folder names must be lowercase\n Rename subdirs of\n  $gmbdr\n    containing\n  $gmtgt?\nRequires perl-rename command" | xmessage -file - -buttons Yes,No -default No -center -timeout 30
+      (( $? == 101 )) && find -H "$gmbdr" -depth -exec perl-rename 's|[^/]*\Z|\L$&|' {} +
+    elif (( $gmchk > 1 )) ; then
+      echo -e "File system is case sensitive\nFile/folder names must be lowercase\n Cannot rename subdirs of\n  $gmbdr\n    containing\n  $gmtgt\n\nBecause more than one exists" | xmessage -file - -buttons Ok:0 -center -timeout 30
+    else
+      echo -e "Config:\n $gmcfg/basedir\n  $gmbse\n found, but not\n  $gmgme\n ($gmbdr/$gmgnm)\n\nRebuild config?" | xmessage -file - -buttons Yes,No -default No -center -timeout 30
+      (( $? == 101 )) && gconf
+    fi
+  else
+    gstart
+  fi
+else
+  echo -e "Config:\n $gmcfg/basedir\n  $gmbse\n not found\n\nRebuild config?" | xmessage -file - -buttons Yes,No -default No -center -timeout 30
+  (( $? == 101 )) && gconf
+fi
