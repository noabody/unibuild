diff a/hexenwail/PKGBUILD b/hexenwail/PKGBUILD
--- a/hexenwail/PKGBUILD	1969-12-31 17:00:00.000000000 -0700
+++ b/hexenwail/PKGBUILD	1969-12-31 17:00:00.000000000 -0700
@@ -0,0 +1,62 @@
+# Maintainer: Noa Body <noabody@archlinux.org>
+
+pkgname=hexenwail
+pkgver=0.8.0.r28.g1723af9
+pkgrel=1
+pkgdesc="Modernized Hexen II engine for SDL3, OpenGL 4.3"
+arch=(x86_64)
+url=https://hexenwail.github.io
+license=(GPL-2.0-only)
+depends=(fluidsynth hicolor-icon-theme libvorbis libxmp
+         opusfile perl-rename sdl3 xorg-fonts-misc)
+makedepends=(gendesk git icoutils inkscape zip)
+conflicts=(uhexen2)
+source=(git+https://github.com/"$pkgname/$pkgname".git
+        "$pkgname".sh)
+sha256sums=('SKIP'
+            '1b88b1b41c9dc81e089417dddf05c7574abcbea0557da1a81c0ea83930426586')
+
+pkgver() {
+  cd "$pkgname"
+  git describe --long --abbrev=7 --tags | sed 's/-beta[^-]*//;s/_/./;s/\([^-]*-g\)/r\1/;s/-/./g'
+}
+
+prepare() {
+  [[ ! -d build ]] || rm -rf build
+	find "$pkgname"/gamecode/hc -type f \( -iname '*.h' -o -iname '*.dat' \) -exec rm -f {} +
+}
+
+build() {
+  cmake -S "$pkgname" -B build \
+    -DCMAKE_BUILD_TYPE=Release \
+    -DBUILD_UTILS=ON \
+    -DBUILD_HEXENWORLD=ON \
+    -DBUILD_DEDICATED=ON \
+    -DCMAKE_SKIP_RPATH=ON
+  cmake --build build -j$(nproc)
+  export PATH="$srcdir/build/bin:$PATH"
+  (cd "$pkgname"/gamecode/hc/h2 && hcc -os)
+  (cd "$pkgname"/gamecode/hc/h2 && hcc -os -name progs2.src)
+  (cd "$pkgname"/gamecode/hc/portals && hcc -os -oi -on)
+  (cd "$pkgname"/gamecode/hc/hw && hcc -os -oi -on)
+  (cd "$pkgname"/gamecode/hc/siege && hcc -os -oi -on)
+}
+
+package() {
+  gendesk -f -n --name="$pkgname" --comment="${pkgdesc/.}" --custom='Keywords=game;engine;' --exec="/usr/share/$pkgname/$pkgname.sh" --icon="$pkgname" --terminal=false --categories='GNOME;GTK;Game' --startupnotify=false --pkgname="$pkgname"
+  install -dm 755 "$pkgdir"/usr/{bin,share/{"$pkgname",applications,icons/hicolor/scalable/apps}}
+  cp -dr --no-preserve='ownership' "$pkgname"/gamecode/res/* "$pkgdir"/usr/share/"$pkgname"/
+  mv "$pkgdir"/usr/share/"$pkgname"/h2 "$pkgdir"/usr/share/"$pkgname"/data1
+  cp -dr --no-preserve='ownership' "$pkgname"/gamecode/patch111/patchdat "$pkgdir"/usr/share/"$pkgname"/
+  cp -dr --no-preserve='ownership' "$pkgname"/gamecode/mapfixes/data1/maps "$pkgdir"/usr/share/"$pkgname"/data1/
+  cp -dr --no-preserve='ownership' "$pkgname"/gamecode/mapfixes/portals/maps "$pkgdir"/usr/share/"$pkgname"/portals/
+  install -m 644 "$pkgname"/gamecode/hc/h2/progs{,2}.dat "$pkgdir"/usr/share/"$pkgname"/data1/
+  install -m 644 "$pkgname"/gamecode/hc/hw/hwprogs.dat "$pkgdir"/usr/share/"$pkgname"/hw/
+  install -m 644 "$pkgname"/gamecode/hc/portals/progs.dat "$pkgdir"/usr/share/"$pkgname"/portals/
+  install -m 644 "$pkgname"/gamecode/hc/siege/hwprogs.dat "$pkgdir"/usr/share/"$pkgname"/siege/
+  install -m 755 build/bin/{glhexen2,h2ded,hwmaster,hwsv} "$pkgdir"/usr/share/"$pkgname"/
+  install -m 755 "$pkgname".sh "$pkgdir"/usr/share/"$pkgname"/
+  install -m 644 "$pkgname".desktop "$pkgdir"/usr/share/applications/
+  install -m 644 "$pkgname"/web/icons/icon.svg "$pkgdir"/usr/share/icons/hicolor/scalable/apps/"$pkgname".svg
+  ln -rsf "$pkgdir"/usr/share/"$pkgname"/{glhexen2,h2ded,hwmaster,hwsv} "$pkgdir"/usr/bin/
+}
diff a/hexenwail/hexenwail.sh b/hexenwail/hexenwail.sh
--- a/hexenwail/hexenwail.sh	1969-12-31 17:00:00.000000000 -0700
+++ b/hexenwail/hexenwail.sh	1969-12-31 17:00:00.000000000 -0700
@@ -0,0 +1,75 @@
+#!/bin/bash
+gmdir="$HOME/games/hexen2"
+gmcfg="$HOME/.hexen2"
+gmtgt="data1/pak0.pak"
+gmprm=""
+glnch="glhexen2"
+
+gconf() {
+mkdir -p "$gmcfg"
+printf 'gamepath=%s\ngamemod=%s\ngameparm=%s\n' "$gmdir" "data1" "$gmprm" > "$gmcfg/basedir"
+}
+
+gstart () {
+while IFS= read -r -d '' file; do
+  [[ -d "$gmbdr/$file" && -z "$first" ]] || mkdir -p "$gmbdr/$file"
+done < <(find /usr/share/hexenwail -mindepth 1 -type d ! \( -ipath '*/docs*' -o -ipath '*/patchdat*' \) -printf '%P\0')
+while IFS= read -r -d '' file; do
+  [[ -h "$gmbdr/$file" && -z "$first" ]] || ln -sf "/usr/share/hexenwail/$file" "$gmbdr/$file"
+done < <(find /usr/share/hexenwail -mindepth 2 -type f ! \( -ipath '*/docs*' -o -ipath '*/patchdat*' -o -iname '*.cfg' -o -iname '*.rc' \) -printf '%P\0')
+while IFS= read -r -d '' file; do
+  [[ -f "$gmbdr/$file" && -z "$first" ]] || cp -f "/usr/share/hexenwail/$file" "$gmbdr/$file"
+done < <(find /usr/share/hexenwail -mindepth 2 -type f \( -iname '*.cfg' -o -iname '*.rc' \) -printf '%P\0')
+echo "$glnch -basedir $gmbdr $gmgnm $gmpar" | xargs -i -r sh -c "{}"
+}
+
+gtest () {
+gmbse="" gmbdr="" gmgme="" gmgnm="" gmgpm="" gmpar=""
+
+if [[ -f "$gmcfg/basedir" ]]; then
+  while IFS='=' read -r key val || [[ -n "$key" ]]; do
+    case "$key" in
+      gamepath) gmbse="gamepath=$val"; gmbdr="$val" ;;
+      gamemod)  gmgme="gamemod=$val";  gmgnm="$val" ;;
+      gameparm) gmgpm="gameparm=$val"; gmpar="$val" ;;
+    esac
+  done < "$gmcfg/basedir"
+fi
+}
+
+[[ -f "$gmcfg/basedir" ]] || { gconf; first=1; }
+gtest
+if [[ -z "$gmbdr" ]]; then
+  gconf ; first=1
+  gtest
+fi
+if [[ -d "$gmbdr" ]]; then
+  if [[ ! -f "$gmbdr/$gmtgt" ]]; then
+    gmchk="$(find -H "$gmbdr" -mindepth 2 -maxdepth 2 -type f -regextype posix-extended -iregex "$gmbdr/$gmtgt" -printf '%p\n' | grep -Pic "$gmbdr/$gmtgt")"
+    if (( $gmchk == 1 )) ; then
+      echo -e "File system is case sensitive\nFile/folder names must be lowercase\n Rename subdirs of\n  $gmbdr\n    containing\n  $gmtgt?\nRequires perl-rename command" | xmessage -file - -buttons Yes,No -default No -center -timeout 30
+      (( $? == 101 )) && find -H "$gmbdr" -depth -exec perl-rename 's|[^/]*\Z|\L$&|' {} +
+    elif (( $gmchk > 1 )) ; then
+      echo -e "File system is case sensitive\nFile/folder names must be lowercase\n Cannot rename subdirs of\n  $gmbdr\n    containing\n  $gmtgt\n\nBecause more than one exists" | xmessage -file - -buttons Ok:0 -center -timeout 30
+    else
+      echo -e "Config:\n $gmcfg/basedir\n  $gmbse\n found, but not\n  $gmgme\n ($gmbdr/$gmtgt)\n\nRebuild config?" | xmessage -file - -buttons Yes,No -default No -center -timeout 30
+      (( $? == 101 )) && gconf
+    fi
+  else
+    if [[ ! -d "$gmbdr/$gmgnm" ]]; then
+      echo -e "Config:\n $gmcfg/basedir\n  $gmbse\n found, but not\n  $gmgme\n ($gmbdr/$gmgnm)\n\nRebuild config?" | xmessage -file - -buttons Yes,No -default No -center -timeout 30
+      (( $? == 101 )) && gconf
+    else
+      if [[ -z "$(echo "$gmgnm" | grep -Pio '\w+')" ]]; then
+        gmgnm=""
+        gstart
+      else
+        gmgnm="-game $gmgnm"
+        gstart
+      fi
+    fi
+  fi
+else
+  echo -e "Config:\n $gmcfg/basedir\n  $gmbse\n not found\n\nRebuild config?" | xmessage -file - -buttons Yes,No -default No -center -timeout 30
+  (( $? == 101 )) && gconf
+fi
