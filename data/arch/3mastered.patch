diff a/3mastered/PKGBUILD b/3mastered/PKGBUILD
--- a/3mastered/PKGBUILD	1969-12-31 17:00:00.000000000 -0700
+++ b/3mastered/PKGBUILD	1969-12-31 17:00:00.000000000 -0700
@@ -0,0 +1,56 @@
+# Maintainer: Noa Body <noabody@archlinux.org>
+
+pkgname=3mastered
+pkgver=0.9.1.r0.g0c2ba3a
+pkgrel=1
+pkgdesc='A light remastering of Descent 3.'
+arch=(x86_64)
+url=https://github.com/noabody/Descent-3MASTERED
+license=(GPL-3.0-only)
+depends=(hicolor-icon-theme libpulse perl-rename sdl3 xorg-fonts-misc)
+makedepends=(cmake gendesk git icoutils inkscape imagemagick sdl3 zip)
+source=("$pkgname"::git+https://github.com/noabody/Descent-3MASTERED.git
+        "$pkgname".sh)
+sha256sums=('SKIP'
+            '5b25fc1217b47e4288a702d57a4d7a1b45d3853583beebfe7db25a79d502dbf1')
+
+pkgver() {
+  cd "$pkgname"
+  local _ver="$(grep -Pio "d\svers.*\b.*\d+\.[[:alnum:]\.]+" CMakeLists.txt | grep -Pio '\d+\.[[:alnum:]\.]+')"
+  printf "%s.r%s.g%s" "$_ver" "$(git rev-list "$(git rev-list --tags --no-walk --max-count=1)"..HEAD --count)" "$(git rev-parse --short=7 HEAD)"
+}
+
+prepare() {
+  if [[ ! -f "$pkgname.svg" ]]; then
+    icotool -i 1 -x "$pkgname"/win32/descent"$pkgname"_256.ico -o "$pkgname".png
+    inkscape "$pkgname".png --export-plain-svg --export-filename="$pkgname".svg
+    rm -f "$pkgname".ico "$pkgname".png
+  fi
+  gendesk -f -n --name='Descent 3MASTERED' --comment="${pkgdesc/.}" --custom='Keywords=game;engine;' --exec="/usr/share/$pkgname/$pkgname.sh" --icon="$pkgname" --terminal=false --categories='GNOME;GTK;Game' --startupnotify=false --pkgname="$pkgname"
+  [[ ! -d "build" ]] || rm -rf build
+}
+
+build() {
+  cmake -S "$pkgname" -B build -G Ninja \
+    -DCMAKE_C_COMPILER=clang \
+    -DCMAKE_CXX_COMPILER=clang++ \
+    -DUSE_SDL=ON \
+    -DCMAKE_BUILD_TYPE=Release \
+    -DCMAKE_INSTALL_PREFIX=/usr \
+    -DCMAKE_SKIP_RPATH=ON
+  cmake --build build -j$(nproc)
+}
+
+package() {
+  install -dm 755 "$pkgdir"/usr/{bin,share/{"$pkgname"/{shader,texture},applications,icons/hicolor/scalable/apps}}
+  cp -dr --no-preserve='ownership' build/netgames3mastered "$pkgdir"/usr/share/"$pkgname"/
+  install -m 755 build/"$pkgname" "$pkgdir"/usr/share/"$pkgname"/
+  install -m 644 build/*.hog "$pkgdir"/usr/share/"$pkgname"/
+  install -m 644 build/libdmfc3m.so "$pkgdir"/usr/share/"$pkgname"/
+  install -m 644 "$pkgname"/hogfiles/descent3mastered/*.{frag,vert} "$pkgdir"/usr/share/"$pkgname"/shader/
+  install -m 644 "$pkgname"/hogfiles/descent3mastered/*.tga "$pkgdir"/usr/share/"$pkgname"/texture/
+  install -m 644 "$pkgname".desktop "$pkgdir"/usr/share/applications/
+  install -m 755 "$pkgname".sh "$pkgdir"/usr/share/"$pkgname"/
+  install -m 644 "$pkgname".svg "$pkgdir"/usr/share/icons/hicolor/scalable/apps/
+  ln -rsf "$pkgdir"/usr/share/"$pkgname/$pkgname" "$pkgdir"/usr/bin/
+}
diff a/3mastered/3mastered.sh b/3mastered/3mastered.sh
--- a/3mastered/3mastered.sh	1969-12-31 17:00:00.000000000 -0700
+++ b/3mastered/3mastered.sh	1969-12-31 17:00:00.000000000 -0700
@@ -0,0 +1,60 @@
+#!/bin/bash
+gmdir="$HOME/games/descent3"
+gmcfg="$HOME/.local/3mastered"
+gmtgt="d3.hog"
+gmprm=""
+glnch="3mastered"
+
+gconf() {
+mkdir -p "$gmcfg"
+printf 'gamepath=%s\ngamemod=%s\ngameparm=%s\n' "$gmdir" "$gmtgt" "$gmprm" > "$gmcfg/basedir"
+}
+
+gstart () {
+while IFS= read -r -d '' file; do
+  [[ -h "$gmcfg/$file" ]] || ln -sf "/usr/share/d1x-rebirth/$file" "$gmcfg/$file"
+done < <(find /usr/share/d1x-rebirth -type f \( -iname '*.dxa' \) -printf '%P\0')
+echo "$glnch $gmbdr $gmpar" | xargs -i -r sh -c "{}"
+}
+
+gtest () {
+gmbse="" gmbdr="" gmgme="" gmgnm="" gmgpm="" gmpar=""
+
+if [[ -f "$gmcfg/basedir" ]]; then
+  while IFS='=' read -r key val || [[ -n "$key" ]]; do
+    case "$key" in
+      gamepath) gmbse="gamepath=$val"; gmbdr="$val" ;;
+      gamemod)  gmgme="gamemod=$val";  gmgnm="$val" ;;
+      gameparm) gmgpm="gameparm=$val"; gmpar="$val" ;;
+    esac
+  done < "$gmcfg/basedir"
+  gmgnm="${gmgnm,,}"
+fi
+}
+
+[[ -f "$gmcfg/basedir" ]] || gconf
+gtest
+if [[ -z "$gmbdr" ]]; then
+  gconf
+  gtest
+fi
+if [[ -d "$gmbdr" ]]; then
+  if [[ ! -f "$gmbdr/$gmgnm" ]]; then
+    gmchk="$(find -H "$gmbdr" -mindepth 1 -maxdepth 1 -type f -regextype posix-extended -iregex "$gmbdr/$gmgnm" -printf '%p\n' | grep -Pic "$gmbdr/$gmgnm")"
+    if (( $gmchk == 1 )) ; then
+      echo -e "File system is case sensitive\nFile/folder names must be lowercase\n Rename subdirs of\n  $gmbdr\n    containing\n  $gmtgt?\nRequires perl-rename command" | xmessage -file - -buttons Yes,No -default No -center -timeout 30
+      (( $? == 101 )) && find -H "$gmbdr" -depth -exec perl-rename 's|[^/]*\Z|\L$&|' {} +
+    elif (( $gmchk > 1 )) ; then
+      echo -e "File system is case sensitive\nFile/folder names must be lowercase\n Cannot rename subdirs of\n  $gmbdr\n    containing\n  $gmtgt\n\nBecause more than one exists" | xmessage -file - -buttons Ok:0 -center -timeout 30
+    else
+      echo -e "Config:\n $gmcfg/basedir\n  $gmbse\n found, but not\n  $gmgme\n ($gmbdr/$gmgnm)\n\nRebuild config?" | xmessage -file - -buttons Yes,No -default No -center -timeout 30
+      (( $? == 101 )) && gconf
+    fi
+  else
+    gmbdr="-hogdir $gmbdr"
+    gstart
+  fi
+else
+  echo -e "Config:\n $gmcfg/basedir\n  $gmbse\n not found\n\nRebuild config?" | xmessage -file - -buttons Yes,No -default No -center -timeout 30
+  (( $? == 101 )) && gconf
+fi
