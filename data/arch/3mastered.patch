+  perl -pi -e 's/(.*loki_utils\.c)pp/\1/gi ; s/lnx(?=main\.cpp)/sdl/gi' "$pkgname"/Descent3/CMakeLists.txt
+  perl -pi -e 's#linux/lnx((app|con|controller|mono)\.cpp)#sdl/sdl\1#gi ; s#linux/(?=registry)#sdl/#gi ; s#.*lnx(con|data|task).*\v##gi ; s#(parent_scope)#sdl/sdldatabase.cpp\n\t\1#gi' "$pkgname"/linux/CMakeLists.txt
+  perl -pi -e 's/(.*wgl\.c.*)/#\1/gi' "$pkgname"/renderer/CMakeLists.txt
+  perl -0777 -pi -e 's/inffile.h/InfFile.h/gi ; s/(#include.*windows\.h.*(?s).+?process\.h(?-s).*)/#ifdef _WIN32\n\1\n#endif/gi' "$pkgname"/sdl/sdlcontroller.cpp
+  perl -pi -e 's/(#include \"dinput\.h\")/#ifdef _WIN32\n\1\n#endif/gi' "$pkgname"/ddio_sdl/sdlio.cpp
+  perl -pi -e 's/(isnan)\<float\>/std::\1/gi' "$pkgname"/dd_sndlib/llsopenal.cpp
+  perl -pi -e 's/(application\.h)/\L\1/gi' "$pkgname"/ddio_sdl/sdl{io,mouse}.cpp
+  perl -pi -e 's/(gameloop\.h)/\L\1/gi' "$pkgname"/Descent3/Controls.cpp
+  perl -pi -e 's/(?<=#include \"scorch\.h")/\nbool Debug_print_block = false\;/gi' "$pkgname"/Descent3/GameLoop.cpp
+  perl -pi -e 's/int (?=(from|addr)size)/socklen_t /gi' "$pkgname"/Descent3/gamespy.cpp
+  perl -pi -e 's/([^\t]*) = (sdl_gl_getswapinterval\()/\2&\1/gi' "$pkgname"/renderer/gl_main.cpp
+  perl -pi -e 's|(?<=sdl)\\|/|gi' "$pkgname"/lib/app{database,lication}.h
+  perl -pi -e 's/.*ipx\.h.*//gi' "$pkgname"/{lib/networking.h,netcon/includes/inetgetfile.h}
+  perl -pi -e 's/(?<=ENGINE_NAME \")descent.*/3mastered"/gi' "$pkgname"/lib/enginebrand.h
+  perl -pi -e 's|(?<=sdl_createthread\()([^,]*)|\1, "\1"|gi' "$pkgname"/{networking/networking.cpp,netcon/inetfile/{CFtp,Chttpget}.cpp}
+  perl -pi -e 's/([^\t]*) = (sdl_gl_getswapinterval\()/\2&\1/gi' "$pkgname"/renderer/gl_main.cpp
+  perl -pi -e 's/(sdl_gl_getprocaddress\(name\))/reinterpret_cast<void*>(\1)/gi' "$pkgname"/renderer/gl_init.cpp
+  # rewrites of missing code
+  perl -pi -e 's/.*\(\(\(a\).*//gi ; s/(#define _macros_h)/\1\n\n#ifdef __cplusplus\n  #include <algorithm>\n  #include <cmath>\n  #include <type_traits>\n  using std::min;\n  using std::max;\n  template <typename T, typename U, typename std::enable_if<!std::is_same<T, U>::value, int>::type = 0>\n  constexpr auto min(const T& a, const U& b) -> typename std::common_type<T, U>::type {return (a < b) ? a : b;}\n  template <typename T, typename U, typename std::enable_if<!std::is_same<T, U>::value, int>::type = 0>\n  constexpr auto max(const T& a, const U& b) -> typename std::common_type<T, U>::type {return (a > b) ? a : b;}\n#else\n  #ifndef max\n  #define max(a,b) (((a) > (b)) ? (a) : (b))\n  #endif\n  #ifndef min\n  #define min(a,b) (((a) < (b)) ? (a) : (b))\n  #endif\n#endif\n/gi' "$pkgname"/lib/Macros.h
+  perl -pi -e 's/(?<=min\(a,b\) ).*/(((a) < (b)) ? (a) : (b))/gi ; s/(?<=max\(a,b\) ).*/(((a) > (b)) ? (a) : (b))/gi' "$pkgname"/lib/{Macros.h,linux/linux_fix.h}
