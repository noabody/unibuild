+  echo -e '#include <stdio.h>\n#include <stdarg.h>\nvoid DebugBuildPrint(const char *fmt, ...) { va_list args; va_start(args, fmt); vprintf(fmt, args); va_end(args); }\nvoid mprintf(int window, const char *fmt, ...) { va_list args; va_start(args, fmt); vprintf(fmt, args); va_end(args); }' > "$pkgname"/sdl/sdlmono.cpp
