b_count == 0) { if (DDIO_glob) SDL_free(DDIO_glob)\; DDIO_glob = nullptr\; DDIO_glob_count = 0\; namebuf[0] = '\0'\; return false\; } ddio_FindFileFetchResult(DDIO_next_glob++, namebuf)\; return true\; }\nbool ddio_FindNextFile(char* namebuf) { if (DDIO_glob == nullptr || DDIO_next_glob >= DDIO_glob_count) { namebuf[0] = '\0'\; return false\; } ddio_FindFileFetchResult(DDIO_next_glob++, namebuf)\; return true\; }#gim' "$pkgname"/ddio_sdl/sdlfile.cpp
+  perl -pi -e 's#\#error.*sdlappdatabase.*#\tconst char* prefPath = (char*)SDL_GetUserFolder(SDL_FOLDER_SAVEDGAMES)\; std::string baseDir = (prefPath && strlen(prefPath) > 0) ? prefPath : (getenv("HOME") ? std::string(getenv("HOME")) + "/.local/share/3mastered" : ".")\; while (!baseDir.empty() && (baseDir.back() == '\''/'\'' || baseDir.back() == '\''\\\\'\'')) baseDir.pop_back()\; ddio_CreateDir(baseDir.c_str())\; std::string filename = baseDir + "/" + REGISTRY_FILENAME\;#gi' "$pkgname"/sdl/sdldatabase.cpp
