+# Maintainer: Noa Body <noabody@archlinux.org>
+
+pkgname=3mastered
+pkgver=0.0.13.r0.g4462524
+pkgrel=1
+pkgdesc='A light remastering of Descent 3.'
+arch=(x86_64)
+url=https://github.com/hurleybird/Descent-3MASTERED
+license=(GPL-3.0-only)
+options=(!buildflags !makeflags)
+depends=(hicolor-icon-theme libpulse perl-rename sdl3 xorg-fonts-misc)
+makedepends=(cmake dos2unix gendesk git icoutils inkscape imagemagick sdl3 zip)
+source=("$pkgname"::git+https://github.com/hurleybird/Descent-3MASTERED.git
+        "$pkgname".patch
+        "$pkgname".sh)
+sha256sums=('SKIP'
+            'f610df3593f06d06990f0b1c2acf3f5f5860aff303dc0e3b2996c397de6a1674'
+            '5b25fc1217b47e4288a702d57a4d7a1b45d3853583beebfe7db25a79d502dbf1')
+
+pkgver() {
+  cd "$pkgname"
+  git describe --long --abbrev=7 --tags | sed 's/^v//;s/_/./;s/\([^-]*-g\)/r\1/;s/-/./g'
+}
+
+prepare() {
+  if [[ ! -f "$pkgname.svg" ]]; then
+    icotool -i 1 -x "$pkgname"/win32/descent"$pkgname"_256.ico -o "$pkgname".png
