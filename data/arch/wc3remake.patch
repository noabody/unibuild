+depends=(hicolor-icon-theme perl-rename sdl2-compat sdl2_mixer_ext sdl2_ttf xorg-fonts-misc)
+makedepends=(cmake git gtest ninja openxr sdl2_mixer_ext sdl2_ttf stb simpleini)
+source=("$pkgname"::git+https://github.com/DMJC/"$pkgname".git
+        CMakeLists.txt
+        "$pkgname".svg::https://raw.githubusercontent.com/noabody/unibuild/master/data/wc1-re.svg
+        "$pkgname".sh)
+sha256sums=('SKIP'
+            '9268b7045fe1df08a863304eb75cae68e7ffd207a763b5b3b730455ea5bfbc43'
+            'b16d63e99a46f0196e8858e2ad77b3d1d703410332f94066d7a73a830d9136f5'
+            '546b9f25a0b49e39e5aab50f86fa96951698c65c8d39e3c511678c170ee2eb9e')
+
+#pkgver() {
+#  cd "$pkgname"
+#  git describe --long --abbrev=7 --tags | sed 's/^v//;s/_/./;s/\([^-]*-g\)/r\1/;s/-/./g'
+#}
+
+prepare() {
+  gendesk -f -n --name='Wing Commander 3 libRealSpace' --comment="${pkgdesc/.}" --custom='Keywords=game;engine;' --exec="/usr/share/$pkgname/$pkgname.sh" --icon="$pkgname" --terminal=false --categories='GNOME;GTK;Game' --startupnotify=false --pkgname="$pkgname"
+  [[ ! -d "build" ]] || rm -rf build
+  sed -i -E 's/(target_link_libraries\([^)]+PRIVATE\s+)stb/\1/g' "$pkgname"/src/executables/*/CMakeLists.txt
+  cp -f CMakeLists.txt "$pkgname"/
+}
+
+build() {
+  cmake -S "$pkgname" -B build -G Ninja \
+    -DCMAKE_TOOLCHAIN_FILE="" \
+    -DCMAKE_BUILD_TYPE=Release \
+    -DCMAKE_INSTALL_PREFIX=/usr/share/"$pkgname"
+  cmake --build build -j$(nproc)
+}
+
+package() {
+#  install -dm 755 "$pkgdir"/usr/{bin,share/{"$pkgname",applications,icons/hicolor/scalable/apps}}
+  DESTDIR="$pkgdir" cmake --build build --target install
+#  install -m 755 "$pkgname"/out-modern/wc1-modern-gui "$pkgdir"/usr/share/"$pkgname/$pkgname"
+#  install -m 644 "$pkgname".desktop "$pkgdir"/usr/share/applications/
+#  install -m 755 "$pkgname".sh "$pkgdir"/usr/share/"$pkgname"/
+#  install -m 644 "$pkgname".svg "$pkgdir"/usr/share/icons/hicolor/scalable/apps/
