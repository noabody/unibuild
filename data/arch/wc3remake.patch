diff a/wc3remake/PKGBUILD b/wc3remake/PKGBUILD
--- a/wc3remake/PKGBUILD	1969-12-31 17:00:00.000000000 -0700
+++ b/wc3remake/PKGBUILD	1969-12-31 17:00:00.000000000 -0700
@@ -0,0 +1,54 @@
+# Maintainer: Noa Body <noabody@archlinux.org>
+
+pkgname=wc3remake
+pkgver=0.0.13.r0.g4462524
+pkgrel=1
+pkgdesc='Wing Commander libRealSpace.'
+arch=(x86_64)
+url=https://github.com/neuromancer/wc3remake
+license=(GPL-3.0-only)
+depends=(ffmpeg hicolor-icon-theme libglvnd perl-rename sdl2-compat sdl2_mixer_ext sdl2_ttf xorg-fonts-misc)
+makedepends=(cmake gendesk git gtest ninja openxr sdl2_mixer_ext sdl2_ttf stb simpleini)
+optdepends=('soundfont-fluid: FluidSynth soundfonts')
+noextract=(WCToolbox-6.0.0-beta.1.zip)
+source=("$pkgname"::git+https://github.com/DMJC/"$pkgname".git
+        WCToolbox-6.0.0-beta.1.zip
+        "$pkgname".patch
+        "$pkgname".svg::https://raw.githubusercontent.com/noabody/unibuild/master/data/wc1-re.svg
+        "$pkgname".sh)
+sha256sums=('SKIP'
+            '22967b142c32aaf8314485a875f8f31a241632adc3d399857babae97d5e71139'
+            '89f6eecd95055405f789e749f6d68d5df027eecc8e8545fc968e9ebabbc45fd0'
+            'b16d63e99a46f0196e8858e2ad77b3d1d703410332f94066d7a73a830d9136f5'
+            'f9804218ddf83d81dbacd82832da75f6493c8f61b55b5e1727e5f1772939a49b')
+
+#pkgver() {
+#  cd "$pkgname"
+#  git describe --long --abbrev=7 --tags | sed 's/^v//;s/_/./;s/\([^-]*-g\)/r\1/;s/-/./g'
+#}
+
+prepare() {
+  mkdir -p wc3-pc-hashes ; bsdtar -xf WCToolbox-6.0.0-beta.1.zip -C wc3-pc-hashes --strip-components=2 'external/wc3-pc-hashes/*'
+  gendesk -f -n --name='Wing Commander 3 libRealSpace' --comment="${pkgdesc/.}" --custom='Keywords=game;engine;' --exec="/usr/share/$pkgname/$pkgname.sh" --icon="$pkgname" --terminal=false --categories='GNOME;GTK;Game' --startupnotify=false --pkgname="$pkgname"
+  [[ ! -d "build" ]] || rm -rf build
+  sed -i -E 's/(target_link_libraries\([^)]+PRIVATE\s+)stb/\1/g' "$pkgname"/src/executables/*/CMakeLists.txt
+  patch -Np1 -i "$pkgname".patch
+}
+
+build() {
+  cmake -S "$pkgname" -B build -G Ninja \
+    -DCMAKE_BUILD_TYPE=Release \
+    -DCMAKE_INSTALL_PREFIX=/usr/share/"$pkgname" \
+    -Wno-deprecated
+  cmake --build build -j$(nproc)
+}
+
+package() {
+  install -dm 755 "$pkgdir"/usr/{bin,share/{"$pkgname",applications,icons/hicolor/scalable/apps}}
+  DESTDIR="$pkgdir" cmake --build build --target install
+  cp -dr --no-preserve='ownership' wc3*hashes "$pkgdir"/usr/share/"$pkgname"/
+  install -m 644 "$pkgname".desktop "$pkgdir"/usr/share/applications/
+  install -m 755 "$pkgname".sh "$pkgdir"/usr/share/"$pkgname"/
+  install -m 644 "$pkgname".svg "$pkgdir"/usr/share/icons/hicolor/scalable/apps/
+  ln -rsf "$pkgdir"/usr/share/"$pkgname"/neowc3 "$pkgdir"/usr/bin/"$pkgname"
+}
diff a/wc3remake/wc3remake.sh b/wc3remake/wc3remake.sh
--- a/wc3remake/wc3remake.sh	1969-12-31 17:00:00.000000000 -0700
+++ b/wc3remake/wc3remake.sh	1969-12-31 17:00:00.000000000 -0700
@@ -0,0 +1,61 @@
+#!/bin/bash
+gmdir="$HOME/games/wc3"
+gmcfg="$HOME/.config/wc3remake"
+gmtgt="missions.tre"
+gmprm=""
+glnch="wc3remake"
+
+gconf() {
+mkdir -p "$gmcfg"
+printf 'gamepath=%s\ngamemod=%s\ngameparm=%s\n' "$gmdir" "$gmtgt" "$gmprm" > "$gmcfg/basedir"
+}
+
+gstart () {
+[[ -f "$gmbdr/assets/config.ini" ]] || cp /usr/share/wc3remake/config.ini "$gmbdr/assets/config.ini"
+grep -Pioq "(?<=^data_path=)$gmbdr" "$gmbdr/assets/config.ini" || perl -pi -e "s#(?<=^data_path=).*#$gmbdr#gi" "$gmbdr/assets/config.ini"
+while IFS= read -r -d '' file; do
+  [[ -h "$gmbdr/$file" ]] || ln -sf "/usr/share/wc3remake/$file" "$gmbdr/$(basename $file)"
+done < <(find /usr/share/wc3remake -mindepth 2 -type f \( -iname '*.txt' \) -printf '%P\0')
+[[ -f "/usr/share/soundfonts/FluidR3_GM.sf2" ]] && export SDL_SOUNDFONTS="/usr/share/soundfonts/FluidR3_GM.sf2"
+echo "cd $gmbdr && $glnch $gmpar" | xargs -i -r sh -c "{}"
+}
+
+gtest () {
+gmbse="" gmbdr="" gmgme="" gmgnm="" gmgpm="" gmpar=""
+
+if [[ -f "$gmcfg/basedir" ]]; then
+  while IFS='=' read -r key val || [[ -n "$key" ]]; do
+    case "$key" in
+      gamepath) gmbse="gamepath=$val"; gmbdr="$val" ;;
+      gamemod)  gmgme="gamemod=$val";  gmgnm="$val" ;;
+      gameparm) gmgpm="gameparm=$val"; gmpar="$val" ;;
+    esac
+  done < "$gmcfg/basedir"
+fi
+}
+
+[[ -f "$gmcfg/basedir" ]] || gconf
+gtest
+if [[ -z "$gmbdr" ]]; then
+  gconf
+  gtest
+fi
+if [[ -d "$gmbdr" ]]; then
+  if [[ ! -f "$gmbdr/$gmgnm" ]]; then
+    gmchk="$(find -H "$gmbdr" -mindepth 1 -maxdepth 2 -type f -regextype posix-extended -iregex "$gmbdr/$gmgnm" -printf '%p\n' | grep -Pic "$gmbdr/$gmgnm")"
+    if (( $gmchk == 1 )) ; then
+      echo -e "File system is case sensitive\nFile/folder names must be lowercase\n Rename subdirs of\n  $gmbdr\n    containing\n  $gmtgt?\nRequires perl-rename command" | xmessage -file - -buttons Yes,No -default No -center -timeout 30
+      (( $? == 101 )) && find -H "$gmbdr" -depth -exec perl-rename 's|[^/]*\Z|\L$&|' {} +
+    elif (( $gmchk > 1 )) ; then
+      echo -e "File system is case sensitive\nFile/folder names must be lowercase\n Cannot rename subdirs of\n  $gmbdr\n    containing\n  $gmtgt\n\nBecause more than one exists" | xmessage -file - -buttons Ok:0 -center -timeout 30
+    else
+      echo -e "Config:\n $gmcfg/basedir\n  $gmbse\n found, but not\n  $gmgme\n ($gmbdr/$gmgnm)\n\nRebuild config?" | xmessage -file - -buttons Yes,No -default No -center -timeout 30
+      (( $? == 101 )) && gconf
+    fi
+  else
+    gstart
+  fi
+else
+  echo -e "Config:\n $gmcfg/basedir\n  $gmbse\n not found\n\nRebuild config?" | xmessage -file - -buttons Yes,No -default No -center -timeout 30
+  (( $? == 101 )) && gconf
+fi
