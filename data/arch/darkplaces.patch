diff a/darkplaces/PKGBUILD b/darkplaces/PKGBUILD
--- a/darkplaces/PKGBUILD	1969-12-31 17:00:00.000000000 -0700
+++ b/darkplaces/PKGBUILD	1969-12-31 17:00:00.000000000 -0700
@@ -0,0 +1,44 @@
+# Maintainer: Noa Body <noabody@archlinux.org>
+
+pkgname=darkplaces
+pkgver=0.8.6.r1378.g5d80f03
+pkgrel=1
+pkgdesc='SDL Quake engine that powers Xonotic.'
+arch=(x86_64)
+url=https://github.com/xonotic/"$pkgname".git
+license=(GPL-2.0-only)
+depends=(hicolor-icon-theme libjpeg-turbo perl-rename sdl2 xorg-fonts-misc zlib)
+makedepends=(gendesk inkscape zlib)
+conflicts=("$pkgname"-2017 "$pkgname"-git "$pkgname"-mod "$pkgname"-rm-git "$pkgname"-xonotic)
+replaces=("$pkgname"-2017 "$pkgname"-git "$pkgname"-mod "$pkgname"-rm-git "$pkgname"-xonotic)
+source=("$pkgname"::git+https://github.com/xonotic/"$pkgname".git#branch=dpmaster
+        "$pkgname".sh)
+sha256sums=('SKIP'
+            '6448514362cfbc6f3773514f443b9f1201090abd0026449b2eeae724063a8743')
+
+pkgver() {
+  cd "$pkgname"
+  local _ver="$(git ls-remote -q --tags --refs | grep -Pio '(\d+(\.|_|-|$)){2}[\w\.-]*' | perl -pe 's|[[:punct:]]|.|g' | sort -V | tail -1)"
+  printf "%s.r%s.g%s" "$_ver" "$(git rev-list "$(git rev-list --tags --no-walk --max-count=1)"..HEAD --count)" "$(git rev-parse --short=7 HEAD)"
+}
+
+prepare() {
+  [[ -f "$pkgname.svg" ]] || inkscape "$pkgname/$pkgname"72x72.png --export-plain-svg --export-filename="$pkgname".svg
+  cd "$pkgname"
+  make clean
+}
+
+build() {
+  cd "$pkgname"
+  make -j$(nproc) release
+}
+
+package() {
+  gendesk -f -n --name='DarkPlaces SDL' --comment="${pkgdesc%.*}" --custom='Keywords=game;engine;' --exec="/usr/share/$pkgname/$pkgname.sh" --icon="$pkgname" --terminal=false --categories='GNOME;GTK;Game' --startupnotify=false --pkgname="$pkgname"
+  install -dm 755 "$pkgdir"/usr/{bin,share/{"$pkgname",applications,icons/hicolor/scalable/apps}}
+  install -m 755 "$pkgname/$pkgname"-{sdl,dedicated} "$pkgdir"/usr/share/"$pkgname"/
+  install -m 755 "$pkgname".sh "$pkgdir"/usr/share/"$pkgname"/
+  install -m 644 "$pkgname".desktop "$pkgdir"/usr/share/applications/
+  install -m 644 "$pkgname".svg "$pkgdir"/usr/share/icons/hicolor/scalable/apps/"$pkgname".svg
+  ln -rsf "$pkgdir"/usr/share/"$pkgname/$pkgname"-{sdl,dedicated} "$pkgdir"/usr/bin/
+}
diff a/darkplaces/darkplaces.sh b/darkplaces/darkplaces.sh
--- a/darkplaces/darkplaces.sh	1969-12-31 17:00:00.000000000 -0700
+++ b/darkplaces/darkplaces.sh	1969-12-31 17:00:00.000000000 -0700
@@ -0,0 +1,66 @@
+#!/bin/bash
+gmdir="$HOME/games/quake"
+gmcfg="$HOME/.darkplaces"
+gmtgt="id1/pak0.pak"
+gmprm=""
+glnch="darkplaces-sdl"
+
+gconf() {
+mkdir -p "$gmcfg"
+printf 'gamepath=%s\ngamemod=%s\ngameparm=%s\n' "$gmdir" "id1" "$gmprm" > "$gmcfg/basedir"
+}
+
+gstart () {
+echo "$glnch -basedir $gmbdr $gmgnm $gmpar" | xargs -i -r sh -c "{}"
+}
+
+gtest () {
+gmbse="" gmbdr="" gmgme="" gmgnm="" gmgpm="" gmpar=""
+
+if [ -f "$gmcfg/basedir" ]; then
+  while IFS='=' read -r key val || [ -n "$key" ]; do
+    case "$key" in
+      gamepath) gmbse="gamepath=$val"; gmbdr="$val" ;;
+      gamemod)  gmgme="gamemod=$val";  gmgnm="$val" ;;
+      gameparm) gmgpm="gameparm=$val"; gmpar="$val" ;;
+    esac
+  done < "$gmcfg/basedir"
+fi
+}
+
+[[ -f "$gmcfg/basedir" ]] || gconf
+gtest
+if [[ -z "$gmbdr" ]]; then
+  gconf
+  gtest
+fi
+if [[ -d "$gmbdr" ]]; then
+  if [[ ! -f "$gmbdr/$gmtgt" ]]; then
+    gmchk="$(find -H "$gmbdr" -mindepth 2 -maxdepth 2 -type f -regextype posix-extended -iregex "$gmbdr/$gmtgt" -printf '%p\n' | grep -Pic "$gmbdr/$gmtgt")"
+    if (( $gmchk == 1 )) ; then
+      echo -e "File system is case sensitive\nFile/folder names must be lowercase\n Rename subdirs of\n  $gmbdr\n    containing\n  $gmtgt?\nRequires perl-rename command" | xmessage -file - -buttons Yes,No -default No -center -timeout 30
+      (( $? == 101 )) && find -H "$gmbdr" -depth -exec perl-rename 's|[^/]*\Z|\L$&|' {} +
+    elif (( $gmchk > 1 )) ; then
+      echo -e "File system is case sensitive\nFile/folder names must be lowercase\n Cannot rename subdirs of\n  $gmbdr\n    containing\n  $gmtgt\n\nBecause more than one exists" | xmessage -file - -buttons Ok:0 -center -timeout 30
+    else
+      echo -e "Config:\n $gmcfg/basedir\n  $gmbse\n found, but not\n  $gmgme\n ($gmbdr/$gmtgt)\n\nRebuild config?" | xmessage -file - -buttons Yes,No -default No -center -timeout 30
+      (( $? == 101 )) && gconf
+    fi
+  else
+    if [[ ! -d "$gmbdr/$gmgnm" ]]; then
+      echo -e "Config:\n $gmcfg/basedir\n  $gmbse\n found, but not\n  $gmgme\n ($gmbdr/$gmgnm)\n\nRebuild config?" | xmessage -file - -buttons Yes,No -default No -center -timeout 30
+      (( $? == 101 )) && gconf
+    else
+      if [[ -z "$(echo "$gmgnm" | grep -Pio '\w+')" ]]; then
+        gmgnm=""
+        gstart
+      else
+        gmgnm="-game $gmgnm"
+        gstart
+      fi
+    fi
+  fi
+else
+  echo -e "Config:\n $gmcfg/basedir\n  $gmbse\n not found\n\nRebuild config?" | xmessage -file - -buttons Yes,No -default No -center -timeout 30
+  (( $? == 101 )) && gconf
+fi
