diff a/descent3/PKGBUILD b/descent3/PKGBUILD
--- a/descent3/PKGBUILD	1969-12-31 17:00:00.000000000 -0700
+++ b/descent3/PKGBUILD	1969-12-31 17:00:00.000000000 -0700
@@ -0,0 +1,57 @@
+# Maintainer: Noa Body <noabody@archlinux.org>
+
+pkgname=descent3
+pkgver=1.6.0.r647.ga3e82bc
+pkgrel=1
+pkgdesc='Descent 3 open source engine.'
+arch=(x86_64)
+url=https://github.com/DescentDevelopers/Descent3
+license=(GPL-3.0-only)
+options=(!buildflags)
+depends=(hicolor-icon-theme perl-rename sdl3 xorg-fonts-misc zlib)
+makedepends=(cmake cpp-httplib gendesk git icoutils inkscape imagemagick sdl3)
+source=("$pkgname"::git+https://github.com/DescentDevelopers/Descent3.git
+        "$pkgname".patch
+        "$pkgname".sh)
+sha256sums=('SKIP'
+            'df89d14b101efebdd2a2387d3bd40b81a18aca0871458b858d9b7ed898b4bc47'
+            '6caea9df14e6ca6c62a8c2ba889f94728ae7e57fe9e61295ee8dc704e306364a')
+
+pkgver() {
+  cd "$pkgname"
+  local _ver="$(grep -Pio "^\s+vers.*\b.*\d+\.[[:alnum:]\.]+" CMakeLists.txt | grep -Pio '\d+\.[[:alnum:]\.]+')"
+  printf "%s.r%s.g%s" "$_ver" "$(git rev-list "$(git rev-list --tags --no-walk --max-count=1)"..HEAD --count)" "$(git rev-parse --short=7 HEAD)"
+}
+
+prepare() {
+  if [[ ! -f "$pkgname.svg" ]]; then
+    icotool -i 1 -x "$pkgname"/Descent3/Descent3.ico -o "$pkgname".png
+    inkscape "$pkgname".png --export-plain-svg --export-filename="$pkgname".svg
+    rm -f "$pkgname".ico "$pkgname".png
+  fi
+  gendesk -f -n --name='Descent 3' --comment="${pkgdesc/.}" --custom='Keywords=game;engine;' --exec="/usr/share/$pkgname/$pkgname.sh" --icon="$pkgname" --terminal=false --categories='GNOME;GTK;Game' --startupnotify=false --pkgname="$pkgname"
+  perl -pi -e 's/([^\s]+)\s(online|tcp~ip)/\1_\2/gi' "$pkgname"/netcon/*/*.txt
+  perl -pi -e 's/(properties\(descent3.*)(?=\))/\1 OUTPUT_NAME "descent3"/gi' "$pkgname"/Descent3/CMakeLists.txt
+  perl -pi -e 's/(?<=pref_org \").*/"/gi ; s/(?<=pref_app \").*/descent3"/gi' "$pkgname"/lib/d3_platform_path.h.in
+  [[ ! -d "build" ]] || rm -rf build
+  patch -Np1 -i "$pkgname".patch
+}
+
+build() {
+  cmake -S "$pkgname" -B build -G Ninja \
+    -DCMAKE_BUILD_TYPE=Release \
+    -DCMAKE_INSTALL_PREFIX=/usr/share/descent3 \
+    -DUSE_VCPKG=OFF \
+    -DDEFAULT_ADDITIONAL_DIRS="/usr/share/descent3/" \
+    -DCMAKE_SKIP_RPATH=ON
+  cmake --build build -j$(nproc)
+}
+
+package() {
+  install -dm 755 "$pkgdir"/usr/{bin,share/{"$pkgname",applications,icons/hicolor/scalable/apps}}
+  DESTDIR="$pkgdir" cmake --build build --target install
+  install -m 644 "$pkgname".desktop "$pkgdir"/usr/share/applications/
+  install -m 755 "$pkgname".sh "$pkgdir"/usr/share/"$pkgname"/
+  install -m 644 "$pkgname".svg "$pkgdir"/usr/share/icons/hicolor/scalable/apps/
+  ln -rsf "$pkgdir"/usr/share/"$pkgname/$pkgname" "$pkgdir"/usr/bin/
+}
diff a/descent3/descent3.sh b/descent3/descent3.sh
--- a/descent3/descent3.sh	1969-12-31 17:00:00.000000000 -0700
+++ b/descent3/descent3.sh	1969-12-31 17:00:00.000000000 -0700
@@ -0,0 +1,60 @@
+#!/bin/bash
+gmdir="$HOME/games/descent3"
+gmcfg="$HOME/.local/share/descent3"
+gmtgt="d3.hog"
+gmprm=""
+glnch="descent3"
+
+gconf() {
+mkdir -p "$gmcfg"
+printf 'gamepath=%s\ngamemod=%s\ngameparm=%s\n' "$gmdir" "$gmtgt" "$gmprm" > "$gmcfg/basedir"
+}
+
+gstart () {
+#while IFS= read -r -d '' file; do
+#  [[ -h "$gmcfg/$file" ]] || ln -sf "/usr/share/d1x-rebirth/$file" "$gmcfg/$file"
+#done < <(find /usr/share/d1x-rebirth -type f \( -iname '*.dxa' \) -printf '%P\0')
+echo "$glnch $gmbdr $gmpar" | xargs -i -r sh -c "{}"
+}
+
+gtest () {
+gmbse="" gmbdr="" gmgme="" gmgnm="" gmgpm="" gmpar=""
+
+if [[ -f "$gmcfg/basedir" ]]; then
+  while IFS='=' read -r key val || [[ -n "$key" ]]; do
+    case "$key" in
+      gamepath) gmbse="gamepath=$val"; gmbdr="$val" ;;
+      gamemod)  gmgme="gamemod=$val";  gmgnm="$val" ;;
+      gameparm) gmgpm="gameparm=$val"; gmpar="$val" ;;
+    esac
+  done < "$gmcfg/basedir"
+  gmgnm="${gmgnm,,}"
+fi
+}
+
+[[ -f "$gmcfg/basedir" ]] || gconf
+gtest
+if [[ -z "$gmbdr" ]]; then
+  gconf
+  gtest
+fi
+if [[ -d "$gmbdr" ]]; then
+  if [[ ! -f "$gmbdr/$gmgnm" ]]; then
+    gmchk="$(find -H "$gmbdr" -mindepth 1 -maxdepth 1 -type f -regextype posix-extended -iregex "$gmbdr/$gmgnm" -printf '%p\n' | grep -Pic "$gmbdr/$gmgnm")"
+    if (( $gmchk == 1 )) ; then
+      echo -e "File system is case sensitive\nFile/folder names must be lowercase\n Rename subdirs of\n  $gmbdr\n    containing\n  $gmtgt?\nRequires perl-rename command" | xmessage -file - -buttons Yes,No -default No -center -timeout 30
+      (( $? == 101 )) && find -H "$gmbdr" -depth -exec perl-rename 's|[^/]*\Z|\L$&|' {} +
+    elif (( $gmchk > 1 )) ; then
+      echo -e "File system is case sensitive\nFile/folder names must be lowercase\n Cannot rename subdirs of\n  $gmbdr\n    containing\n  $gmtgt\n\nBecause more than one exists" | xmessage -file - -buttons Ok:0 -center -timeout 30
+    else
+      echo -e "Config:\n $gmcfg/basedir\n  $gmbse\n found, but not\n  $gmgme\n ($gmbdr/$gmgnm)\n\nRebuild config?" | xmessage -file - -buttons Yes,No -default No -center -timeout 30
+      (( $? == 101 )) && gconf
+    fi
+  else
+    gmbdr="-additionaldir $gmbdr"
+    gstart
+  fi
+else
+  echo -e "Config:\n $gmcfg/basedir\n  $gmbse\n not found\n\nRebuild config?" | xmessage -file - -buttons Yes,No -default No -center -timeout 30
+  (( $? == 101 )) && gconf
+fi
