+
+prepare() {
+  for _icon in doom heretic hexen strife; do
+    [[ -f "chocolate-$_icon.svg" ]] || inkscape "$pkgbase"/data/"$_icon".png --export-plain-svg --export-filename=chocolate-"$_icon".svg
+  done
+  [[ -f "chocolate-setup.svg" ]] || inkscape "$pkgbase"/data/setup.png --export-plain-svg --export-filename=chocolate-setup.svg
