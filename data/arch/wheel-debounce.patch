+++ b/wheel-debounce/PKGBUILD	1969-12-31 17:00:00.000000000 -0700
@@ -0,0 +1,15 @@
+# Maintainer: Noa Body <noabody@archlinux.org>
+
+pkgname=wheel-debounce
+pkgver=1.0
+pkgrel=1
+pkgdesc="libinput mouse wheel debounce lua script."
+license=(GPL-3.0-only)
+arch=(any)
+source=(10-wheel-debounce.lua)
+depends=(libinput)
+sha256sums=('e065b38b0421e939f3f9708a3d3d263f701a655e8e3d8482a9112ca1f45de5fa')
+
+package() {
+  install -Dm644 10-wheel-debounce.lua -t "$pkgdir"/etc/libinput/plugins/
