diff a/wheel-debounce/10-wheel-debounce.lua b/wheel-debounce/10-wheel-debounce.lua
index e69de29..fa74c6d 100644
--- a/wheel-debounce/10-wheel-debounce.lua	1969-12-31 17:00:00.000000000 -0700
+++ b/wheel-debounce/10-wheel-debounce.lua	1969-12-31 17:00:00.000000000 -0700
@@ -0,0 +1,85 @@
+libinput:register({1})
+
+local IDLE_RESET_US     = 1500000 -- 1.5s idle resets state
+local MIN_INTERVAL_US   = 15000   -- 15ms floor: rejects sub-millisecond ESD ringing bursts
+local CONFIRM_WINDOW_US = 250000  -- 250ms max gap to confirm a first-click from idle or reversal
+
+local active_dir  = 0
+local pending_dir = 0
+local last_time   = 0
+local pending_time = 0
+
+local function on_evdev_frame(device, frame, time)
+    local filtered = {}
+    local modified = false
+    local frame_dir = 0
+
+    for _, event in ipairs(frame) do
+        if event.usage == evdev.REL_WHEEL or event.usage == evdev.REL_WHEEL_HI_RES then
+            if event.value ~= 0 then
+                frame_dir = event.value > 0 and 1 or -1
+            end
+        end
+    end
+
+    if frame_dir ~= 0 then
+        local dt = time - last_time
+
+        -- 1. Reject physically impossible sub-15ms bursts (ESD / RF ringing)
+        if last_time ~= 0 and dt < MIN_INTERVAL_US then
+            modified = true
+        else
+            -- 2. Return to neutral after idle so an isolated static pop cannot trigger a scroll
+            if dt > IDLE_RESET_US then
+                active_dir = 0
+                pending_dir = 0
+            end
+
+            if active_dir == 0 then
+                -- Coming out of idle: require 2 consecutive pulses in the same direction within CONFIRM_WINDOW_US
+                if pending_dir == frame_dir and (time - pending_time) <= CONFIRM_WINDOW_US then
+                    active_dir = frame_dir
+                    pending_dir = 0
+                else
+                    pending_dir = frame_dir
+                    pending_time = time
+                    modified = true
+                end
+            elseif frame_dir ~= active_dir then
+                -- Direction reversal: require 2 consecutive pulses within CONFIRM_WINDOW_US
+                if pending_dir == frame_dir and (time - pending_time) <= CONFIRM_WINDOW_US then
+                    active_dir = frame_dir
+                    pending_dir = 0
+                else
+                    pending_dir = frame_dir
+                    pending_time = time
+                    modified = true
+                end
+            else
+                -- Continued in active direction: clear any isolated glitch
+                pending_dir = 0
+            end
+
+            last_time = time
+        end
+    end
+
+    if not modified then
+        return nil
+    end
+
+    for _, event in ipairs(frame) do
+        if event.usage ~= evdev.REL_WHEEL and event.usage ~= evdev.REL_WHEEL_HI_RES then
+            table.insert(filtered, event)
+        end
+    end
+
+    return filtered
+end
+
+libinput:connect("new-evdev-device", function(device)
+    local usages = device:usages()
+    if usages[evdev.REL_WHEEL] or usages[evdev.REL_WHEEL_HI_RES] then
+        device:connect("evdev-frame", on_evdev_frame)
+    end
+end)
