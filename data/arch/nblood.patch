+        etekwar.sh
+        ewitchaven.sh
+        pcexhumed.sh
+        rednukem.sh)
+sha256sums=('SKIP'
+            '0a5018dbac30db96b33293911ff296f26b558cd6e5b8dcbd05ee50305fc3d6fc'
+            '4469d27d887b7a3d6e333c2419810a97e9760d44288bf25ce824f9c14c90a81b'
+            'a9a23fc6ee88ec5e35639be3ebb1da9bbc1b912809d7a8cf91234d71bc910ad7'
+            'ec5b5e724e5174eb6507213f79604bd66479574189f6715c3cbe7dd7248d6e7b'
