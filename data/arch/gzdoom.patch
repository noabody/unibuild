diff a/gzdoom/PKGBUILD b/gzdoom/PKGBUILD
--- a/gzdoom/PKGBUILD	1969-12-31 17:00:00.000000000 -0700
+++ b/gzdoom/PKGBUILD	1969-12-31 17:00:00.000000000 -0700
@@ -0,0 +1,60 @@
+# Maintainer: Noa Body <noabody@archlinux.org>
+
+pkgname=gzdoom
+pkgver=4151.r572.gc26ce2e
+pkgrel=1
+pkgdesc='OpenGL ZDoom DOOM engine source port.'
+arch=(x86_64)
+url=https://zdoom.org
+license=(BSD-1-Clause GPL-3.0-only LGPL-3.0-only)
+depends=(bzip2 hicolor-icon-theme gtk3 libgl libvpx openal
+         perl-rename sdl2 xorg-fonts-misc zmusic zlib)
+makedepends=(cmake desktop-file-utils
+             gendesk fluidsynth git gtk3)
+optdepends=('soundfont-fluid: FluidSynth soundfonts'
+            'freepats-general-midi: midi soundfonts'
+            'vulkan-driver: Vulkan renderer'
+            'vulkan-icd-loader: Vulkan renderer')
+options=(!lto)
+source=("$pkgname"::git+https://github.com/coelckers/"$pkgname".git
+        "$pkgname".sh)
+replaces=("$pkgname"-git "$pkgname"-legacy "$pkgname"-legacy-git super"$pkgname")
+conflicts=("$pkgname"-git "$pkgname"-legacy "$pkgname"-legacy-git super"$pkgname")
+sha256sums=('SKIP'
+            '910bfef9fc7b0e16d9ba0127a0d54f4742cec527e1945ea4a0d2c44ca7fd142c')
+
+pkgver() {
+  cd "$pkgname"
+  local _ver="$(grep -Pio "ver.*_(ma|mi|re).*\b.*\d+" src/version.h | grep -Pio '\d+$' | perl -pe 's|\s|.| ; s|(.*)\.$|\1|')"
+  printf "%s.r%s.g%s" "$_ver" "$(git rev-list "$(git rev-list --tags --no-walk --max-count=1)"..HEAD --count)" "$(git rev-parse --short=7 HEAD)"
+}
+
+prepare() {
+  perl -pi -e 's|(.*/usr/)(local/)(share/)(doom.*)|\1\2\3\4\n\1\3gz\4|gi ; s|(.*HOME/)(\.local/share/)(games/doom.*)|\1\2\3\n\1\3|gi' "$pkgname"/src/gameconfigfile.cpp
+  git -C "$pkgname" submodule update --init --recursive
+  [[ ! -d build ]] || rm -rf build
+}
+
+build() {
+  cmake -S "$pkgname" -B build \
+    -DCMAKE_BUILD_TYPE=Release \
+    -DCMAKE_CXX_FLAGS="${CXXFLAGS} -ffile-prefix-map=\"$PWD\"=. -DSHARE_DIR=\\\"/usr/share/gzdoom\\\" -DGAME_DIR=\\\"games/doom\\\"" \
+    -DCMAKE_INSTALL_PREFIX=/usr \
+    -DINSTALL_PATH=share/$pkgname \
+    -DINSTALL_PK3_PATH=share/$pkgname \
+    -DINSTALL_SOUNDFONT_PATH=share/$pkgname \
+    -DSYSTEMINSTALL=ON \
+    -DDYN_GTK=OFF \
+    -DDYN_OPENAL=OFF \
+    -DCMAKE_SKIP_RPATH=ON
+  cmake --build build -j$(nproc)
+}
+
+package() {
+  install -dm 755 "$pkgdir"/usr/bin
+  DESTDIR="$pkgdir" cmake --build build --target install
+  rm -rf "$pkgdir"/usr/{include,lib}
+#  perl -pi -e "s|(?<=^Exec=)[^\s]+|\1/usr/share/$pkgname/$pkgname.sh|g" "$pkgdir"/usr/share/applications/*GZDoom*.desktop
+#  install -m 755 "$pkgname".sh "$pkgdir"/usr/share/"$pkgname"/
+  ln -rsf "$pkgdir"/usr/share/"$pkgname/$pkgname" "$pkgdir"/usr/bin/
+}
diff a/gzdoom/gzdoom.sh b/gzdoom/gzdoom.sh
--- a/gzdoom/gzdoom.sh	1969-12-31 17:00:00.000000000 -0700
+++ b/gzdoom/gzdoom.sh	1969-12-31 17:00:00.000000000 -0700
@@ -0,0 +1,64 @@
+#!/bin/bash
+gmdir="$HOME/games/doom"
+gmcfg="$HOME/.config/gzdoom"
+gmtgt="doom.wad"
+gmprm="-file nerve.wad"
+glnch="gzdoom"
+
+gconf() {
+mkdir -p "$gmcfg"
+printf 'gamepath=%s\ngamemod=%s\ngameparm=%s\n' "$gmdir" "$gmtgt" "$gmprm" > "$gmcfg/basedir"
+}
+
+gstart () {
+while IFS= read -r -d '' file; do
+  [[ -h "$gmcfg/$file" ]] || ln -sf "/usr/share/gzdoom/$file" "$gmcfg/$file"
+done < <(find /usr/share/gzdoom -type f \( -iname '*.pk3' \) -printf '%P\0')
+echo "cd $gmbdr && DOOMWADDIR=$gmbdr $glnch $gmgnm $gmpar" | xargs -i -r sh -c "{}"
+}
+
+gtest () {
+gmbse="" gmbdr="" gmgme="" gmgnm="" gmgpm="" gmpar=""
+
+if [[ -f "$gmcfg/basedir" ]]; then
+  while IFS='=' read -r key val || [[ -n "$key" ]]; do
+    case "$key" in
+      gamepath) gmbse="gamepath=$val"; gmbdr="$val" ;;
+      gamemod)  gmgme="gamemod=$val";  gmgnm="$val" ;;
+      gameparm) gmgpm="gameparm=$val"; gmpar="$val" ;;
+    esac
+  done < "$gmcfg/basedir"
+  gmgnm="${gmgnm,,}"
+fi
+}
+
+[[ -f "$gmcfg/basedir" ]] || gconf
+gtest
+if [[ -z "$gmbdr" ]]; then
+  gconf
+  gtest
+fi
+if [[ -d "$gmbdr" ]]; then
+  if [[ ! -f "$gmbdr/$gmgnm" ]]; then
+    gmchk="$(find -H "$gmbdr" -mindepth 1 -maxdepth 1 -type f -regextype posix-extended -iregex "$gmbdr/$gmgnm" -printf '%p\n' | grep -Pic "$gmbdr/$gmgnm")"
+    if (( $gmchk == 1 )) ; then
+      echo -e "File system is case sensitive\nFile/folder names must be lowercase\n Rename subdirs of\n  $gmbdr\n    containing\n  $gmtgt?\nRequires perl-rename command" | xmessage -file - -buttons Yes,No -default No -center -timeout 30
+      (( $? == 101 )) && find -H "$gmbdr" -depth -exec perl-rename 's|[^/]*\Z|\L$&|' {} +
+    elif (( $gmchk > 1 )) ; then
+      echo -e "File system is case sensitive\nFile/folder names must be lowercase\n Cannot rename subdirs of\n  $gmbdr\n    containing\n  $gmtgt\n\nBecause more than one exists" | xmessage -file - -buttons Ok:0 -center -timeout 30
+    elif [[ -z "$(echo "$gmgnm" | grep -Pio '\w+')" && -n "$(find -H "$gmbdr" -mindepth 1 -maxdepth 1 -type f -iname '*.wad' -printf '%f')" ]]; then
+      [[ -z "$(grep -Pio "queryiwad=true" "$gmcfg/gzdoom.ini")" ]] && sed -i "s|\(queryiwad=\).*|\\1true|" "$gmcfg/gzdoom.ini"
+      gmgnm=""
+      gstart
+    else
+      echo -e "Config:\n $gmcfg/basedir\n  $gmbse\n found, but not\n  $gmgme\n ($gmbdr/$gmgnm)\n\nRebuild config?" | xmessage -file - -buttons Yes,No -default No -center -timeout 30
+      (( $? == 101 )) && gconf
+    fi
+  else
+    gmgnm="-iwad $gmgnm"
+    gstart
+  fi
+else
+  echo -e "Config:\n $gmcfg/basedir\n  $gmbse\n not found\n\nRebuild config?" | xmessage -file - -buttons Yes,No -default No -center -timeout 30
+  (( $? == 101 )) && gconf
+fi
