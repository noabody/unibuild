+++ b/buildgdx/PKGBUILD	1969-12-31 17:00:00.000000000 -0700
@@ -0,0 +1,78 @@
+# Maintainer: Noa Body <noabody@archlinux.org>
+
+pkgname=buildgdx
+_pkgname=BuildGDX
+pkgver=1.19.r216.g16671ed
+pkgrel=1
+pkgdesc="Port of Build Engine games based on LibGDX."
+arch=(any)
+url=https://gitlab.com/m210/BuildGDX
+license=(GPL-3.0-or-later)
+depends=(bash hicolor-icon-theme 'java-runtime>=25')
+makedepends=(gendesk gradle inkscape imagemagick jdk25-openjdk)
+provides=("$pkgname")
+conflicts=("$pkgname")
+replaces=("$pkgname")
+source=(git+https://gitlab.com/m210/BuildGDX.git#branch=add_lighting
+        git+https://gitlab.com/m210/BloodGDX.git#branch=add_lighting
+        git+https://gitlab.com/m210/BuildGDX-Launcher.git#branch=develop
+        git+https://gitlab.com/m210/BuildSmaker.git
+        git+https://gitlab.com/m210/DukeGDX.git#branch=add_lighting
+        git+https://gitlab.com/m210/LSPGDX.git#branch=add_lighting
+        git+https://gitlab.com/m210/PowerslaveGDX.git#branch=add_lighting
+        git+https://gitlab.com/m210/RedneckGDX.git#branch=add_lighting
+        git+https://gitlab.com/m210/TekwarGDX.git#branch=add_lighting
+        git+https://gitlab.com/m210/WangGDX.git#branch=add_lighting
+        git+https://gitlab.com/m210/WitchavenGDX.git#branch=add_lighting
+        git+https://gitlab.com/m210/vfs.git
+        "$pkgname".patch
+        "$pkgname".sh)
+
+sha256sums=('SKIP'
+            'SKIP'
+            'SKIP'
+            'SKIP'
+            'SKIP'
+            'SKIP'
+            'SKIP'
+            'SKIP'
+            'SKIP'
+            'SKIP'
+            'SKIP'
+            'SKIP'
+            '18ee6edbed725b0059117f6ec9c3c0747be519dc02dc371e3c76a53314ac713d'
+            'c0bcc1ae95dfd96944d76b5467820b8763185643e8e6d010e2ffb1abdcddf272')
+
+pkgver() {
+  cd "$_pkgname"-Launcher
+  local _ver="$(grep -Pio "appvers.*\b.*\d+\.[[:alnum:]\.]+" src/ru/m210projects/Launcher/desktop/Main.java | grep -Pio '\d+\.[[:alnum:]\.]+')"
+  printf "%s.r%s.g%s" "$_ver" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
+}
+
+prepare() {
+  gendesk -f -n --name="$_pkgname" --comment="${pkgdesc/.}" --custom='Keywords=game;console;' --exec="$pkgname" --icon="$pkgname" --terminal=false --categories='GNOME;GTK;Game' --startupnotify=false --pkgname="$pkgname"
+  rm -rf *.gradle
+  patch -Np1 -i "$pkgname".patch
+  rm -rf {build,*/build}
+  rm -rf {BuildSmaker,vfs}/src/test
+  perl -pi -e 's/(?<=protected boolean gShowFPS = )[^\s\;]+/false/gi' BuildGDX/core/src/ru/m210projects/Build/settings/VideoContext.java
+  perl -0777 -pi -e 's/^\s+int chartX = 10.*(?s).+?MEM_USAGE_CHART.update(?-s).*//im' BuildGDX/core/src/ru/m210projects/Build/Engine.java
+  perl -MFile::Find -e 'find(sub { return unless /\.java$/i && open my $f, "<", $_; do { local $/; <$f> } =~ /^\s*public\s+(?:(?:final|abstract|sealed|non-sealed)\s+)*(?:class|enum|interface|record)\s+([A-Za-z0-9_]+)/m or return; my $target = "$1.java"; rename $_, $target if $_ ne $target; }, "BuildGDX/core/src");'
+}
+
+build() {
+  if [ ! -f "$pkgname.svg" ]; then
+    magick "$_pkgname"-Launcher/res/Games/Blood/blood128.png -thumbnail 256x256 -strip "$pkgname".gif
+    inkscape "$pkgname".gif --export-plain-svg --export-filename="$pkgname".svg
+    rm -f "$pkgname".gif
+  fi
+  JAVA_HOME=/usr/lib/jvm/java-25-openjdk gradle --no-daemon clean build
+}
+
+package() {
+  install -dm 755 "$pkgdir"/usr/{bin,share/{applications,icons/hicolor/scalable/apps,java/"$pkgname"}}
+  install -m 755 "$pkgname".sh "$pkgdir"/usr/bin/"$pkgname"
+  install -m 644 "$pkgname".desktop "$pkgdir"/usr/share/applications/
+  install -m 644 "$pkgname".svg "$pkgdir"/usr/share/icons/hicolor/scalable/apps/
+  install -m 644 "$_pkgname"-Launcher/build/libs/"$_pkgname"-Launcher.jar "$pkgdir"/usr/share/java/"$pkgname/$pkgname".jar
+}
diff a/buildgdx/buildgdx.sh b/buildgdx/buildgdx.sh
index e69de29..e223692 100755
--- a/buildgdx/buildgdx.sh	1969-12-31 17:00:00.000000000 -0700
+++ b/buildgdx/buildgdx.sh	1969-12-31 17:00:00.000000000 -0700
@@ -0,0 +1,74 @@
+#!/bin/bash
+set -euo pipefail
+
+gmdir="$HOME/games"
+gmcfg="$HOME/.m210projects"
+
+# Detect Java 25 binary directory reliably
+jre25="$(find /usr/lib/jvm -maxdepth 1 -type d -iname '*java*25*' | head -n 1)"
+
+gconf() {
+  mkdir -p "$gmcfg"
+  echo "gamepath= $gmdir" > "$gmcfg/basedir"
+}
+
+gtest() {
+  if [[ -f "$gmcfg/basedir" ]]; then
+    local line
+    line="$(grep -Pi '^gamepath=.*' "$gmcfg/basedir" | head -n 1 || true)"
+    gmbdr="${line#gamepath= }"
+  else
+    gmbdr=""
+  fi
+}
+
+gstart() {
+  local fingerprints=(
+    "BloodGDX-blood.rff"
+    "DukeGDX-duke3d.grp"
+    "LSPGDX-l0art000.dat"
+    "NamGDX-nam.grp"
+    "PowerslaveGDX-book.mov"
+    "RedneckAgainGDX-makeout.con"
+    "RedneckGDX-tornado.con"
+    "WangGDX-sw.grp"
+    "TekWarGDX-matrix.map"
+    "WitchavenGDX-level35.map"
+    "Witchaven2GDX-f_songs"
+  )
+
+  for entry in "${fingerprints[@]}"; do
+    local gmtgt="${entry%-*}"
+    local gmini="${gmtgt,,}.ini"
+    local gmvfy="${entry#*-}"
+    local cfg_dir="$gmcfg/$gmtgt"
+    local cfg_file="$cfg_dir/$gmini"
+
+    # Only run filesystem lookup if the INI file does not already exist
+    if [[ ! -f "$cfg_file" ]]; then
+      local gmpth
+      gmpth="$(find -H "$gmbdr" -maxdepth 2 -type f -iname "$gmvfy" -printf '%h\n' -quit 2>/dev/null || true)"
+
+      if [[ -n "$gmpth" ]]; then
+        mkdir -p "$cfg_dir"
+        printf '[Main]\nPath = %s\n' "$gmpth" > "$cfg_file"
+      fi
+    fi
+  done
+
+  # Launch Java with specific runtime if located, else fall back to system default
+  if [[ -n "$jre25" && -d "$jre25/bin" ]]; then
+    JAVA_HOME="$jre25" PATH="$jre25/bin:$PATH" exec java -jar /usr/share/java/buildgdx/buildgdx.jar "$@"
+  else
+    exec java -jar /usr/share/java/buildgdx/buildgdx.jar "$@"
+  fi
+}
+
+# Main execution flow
+gtest
+if [[ -z "$gmbdr" ]]; then
+  gconf
+  gtest
+fi
+
+gstart "$@"
diff a/buildgdx/buildgdx.patch b/buildgdx/buildgdx.patch
index e69de29..e223692 100755
--- a/buildgdx/buildgdx.patch	1969-12-31 17:00:00.000000000 -0700
