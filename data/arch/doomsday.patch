diff a/doomsday/PKGBUILD b/doomsday/PKGBUILD
--- a/doomsday/PKGBUILD	1969-12-31 17:00:00.000000000 -0700
+++ b/doomsday/PKGBUILD	1969-12-31 17:00:00.000000000 -0700
@@ -0,0 +1,50 @@
+# Maintainer: Noa Body <noabody@archlinux.org>
+
+pkgname=doomsday
+pkgver=3.0.0.r1132.gaa09feb
+pkgrel=1
+pkgdesc='DOOM variant enhanced graphics port.'
+arch=(x86_64)
+url=http://dengine.net
+license=(GPL-2.0-only)
+depends=(assimp curl fluidsynth glbinding glu hicolor-icon-theme 
+         libunistring libxrandr minizip ncurses openal pcre2  
+         sdl2-compat sdl2_mixer soundfont-fluid zlib)
+makedepends=(assimp cmake git glu glbinding imagemagick ninja sdl2 python)
+source=("$pkgname"::git+https://github.com/skyjake/Doomsday-Engine.git
+        https://github.com/noabody/unibuild/raw/master/data/denglibs.tar.xz)
+replaces=("$pkgname" "$pkgname"-bin)
+conflicts=("$pkgname" "$pkgname"-bin)
+sha256sums=('SKIP'
+            '521a0bd2279527bf2a595928648b18045943e4fe4065597bebb1441156aa78d0')
+
+pkgver() {
+  cd "$pkgname"
+  local _ver="$(grep -Pio "ver.*_(ma|mi|pa).*\b.*\d+" "$pkgname"/cmake/Version.cmake | grep -Pio '\d+$' | perl -pe 's|\s|.|' | perl -pe 's|(.*)\.$|\1|')"
+  printf "%s.r%s.g%s" "$_ver" "$(git rev-list "$(git rev-list --tags --no-walk --max-count=1)"..HEAD --count)" "$(git rev-parse --short=7 HEAD)"
+}
+
+prepare() {
+  [[ ! -d "build" ]] || rm -rf build
+  cd "$pkgname"
+  python "$pkgname"/build/scripts/build_deps.py clean
+#  perl -pi -e "s/(.*DTFDN_ENABLE_TLSREQUEST=NO.*)$/\1\n         '-DTFDN_ENABLE_SSE41=NO',/gi" "$pkgname"/build/scripts/build_deps.py
+  perl -pi -e 's|(.*lib_Foundation.so.*)$|\1\n                   \${the_Foundation_DIR}/../../lib_Foundation.so.1\n                   \${the_Foundation_DIR}/../../lib_Foundation.so.1.13.2|gi' "$pkgname"/libs/core/CMakeLists.txt
+  perl -0777 -pi -e 's|(.*NativePath const systemWads.*(?s).+?\}(?-s).*)|        if (const char *home = getenv("HOME"))\n        {\n            NativePath userWads = NativePath(home) / "games/doom";\n            if (userWads.exists())\n            {\n                attachWadFeed("user-custom", userWads, DirectoryFeed::PopulateNativeSubfolders);\n            }\n        }\n\1|gim' "$pkgname"/libs/"$pkgname"/src/"$pkgname"app.cpp
+}
+
+build() {
+  python "$pkgname/$pkgname"/build/scripts/build_deps.py --skip-assimp --skip-glbinding -t Release build
+  cmake -S "$pkgname/$pkgname" -B build -G Ninja \
+    -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
+    -DCMAKE_BUILD_TYPE=Release \
+    -DCMAKE_INSTALL_PREFIX=/usr \
+    -DDE_USE_SYSTEM_GLBINDING=ON \
+    -DDE_USE_SYSTEM_ASSIMP=ON \
+    -DFMOD_DIR="$srcdir"/fmod
+  cmake --build build -j$(nproc)
+}
+
+package() {
+  DESTDIR="$pkgdir" cmake --build build --target install
+}
