+
+prepare() {
+  for _icon in doom heretic hexen strife; do
+    [[ -f "crispy-$_icon.svg" ]] || inkscape "$pkgbase"/data/"$_icon".png --export-plain-svg --export-filename=crispy-"$_icon".svg
+  done
+  [[ -f "crispy-setup.svg" ]] || inkscape "$pkgbase"/data/setup.png --export-plain-svg --export-filename=crispy-setup.svg
