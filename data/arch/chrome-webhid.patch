diff a/chrome-webhid/PKGBUILD b/chrome-webhid/PKGBUILD
--- a/chrome-webhid/PKGBUILD	1969-12-31 17:00:00.000000000 -0700
+++ b/chrome-webhid/PKGBUILD	1969-12-31 17:00:00.000000000 -0700
@@ -0,0 +1,21 @@
+# Maintainer: Noa Body <noabody@archlinux.org>
+
+pkgname=chrome-webhid
+pkgver=1.0
+pkgrel=1
+pkgdesc="Support Linux Chrome WebHID API access to EpoMaker devices."
+arch=(any)
+license=(GPL-3.0-only)
+depends=(google-chrome)
+makedepends=(gendesk)
+source=(50-webhid.rules)
+sha256sums=('ed1e3ae7e528ba2f2dd281384ae5616a1eb60fbb50cdd8f39427abaca14ad09a')
+
+prepare() {
+  gendesk -f -n --name='Epomaker HUB' --comment="${pkgdesc/.}" --custom='Keywords=utility;' --exec='google-chrome-stable --start-fullscreen https://hub.epomaker.com/key-mapping' --icon=org.xfce.settings.keyboard --terminal=false --categories='GNOME;GTK;Settings' --startupnotify=false --pkgname="$pkgname"
+}
+
+package() {
+  install -Dm 644 50-webhid.rules -t "$pkgdir"/etc/udev/rules.d
+  install -Dm 644 "$pkgname".desktop -t "$pkgdir"/usr/share/applications
+}
diff a/chrome-webhid/50-webhid.rules b/chrome-webhid/50-webhid.rules
index e69de29..fa74c6d 100644
--- a/chrome-webhid/50-webhid.rules	1969-12-31 17:00:00.000000000 -0700
+++ b/chrome-webhid/50-webhid.rules	1969-12-31 17:00:00.000000000 -0700
@@ -0,0 +1,5 @@
+# Epomaker / Skyloong / Machenike / WestBerry WebHID udev rules
+KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="3151", MODE="0660", TAG+="uaccess"
+KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="05af", MODE="0660", TAG+="uaccess"
+KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="320f", MODE="0660", TAG+="uaccess"
+KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0483", MODE="0660", TAG+="uaccess"
